CONFIG_IDF_TARGET="esp32s3"
# Verify flash size on your unit
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# PSRAM (octal, e.g. N16R8 modules)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

# TLS buffers in PSRAM (Gemini WebSocket + other HTTPS at once)
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000

# Power management (light sleep between audio frames where possible)
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y

# Speech recognition (ESP-SR): "Jarvis" wake word, models in the "model" partition
CONFIG_MODEL_IN_FLASH=y
CONFIG_SR_WN_WN9_JARVIS_TTS=y

# Task stacks: headroom for logging (diagnostics log capture), JSON and TLS
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=3072
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y

# Network sockets. The default (10) is exactly what the web server can hold open by
# itself, so with the setup/diagnostics page open Gemini couldn't connect (errno 23).
CONFIG_LWIP_MAX_SOCKETS=20

# Software AES for TLS. Hardware AES needs internal-RAM DMA buffers, and when internal
# RAM ran short a Gemini connection failed with "esp-aes: Failed to allocate memory".
# Our traffic (~50 KB/s of audio) is easy work for software AES.
CONFIG_MBEDTLS_HARDWARE_AES=n
